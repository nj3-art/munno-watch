APP_ENV=development
SECRET_KEY=replace-with-a-random-secret
DATABASE_URL=sqlite:///cinezone-dev.db
STORAGE_BACKEND=local
MEDIA_STORAGE_PATH=instance/media

# Configure these only when using an S3-compatible object-storage service.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=

# Optional site/contact (can also be managed via admin settings when implemented)
# SITE_NAME=CineZone
# CONTACT_EMAIL=admin@example.com

# boto3 reads AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN,
# or the configured machine/role credential provider chain.
# Never commit real secrets. Use a managed MySQL DATABASE_URL in production.

# Metadata import (TMDB). Requires API key and compliance with TMDB terms/attribution.
# TMDB_API_KEY=
