APP_ENV=development
SECRET_KEY=replace-with-a-random-secret
DATABASE_URL=sqlite:///cinezone-dev.db
STORAGE_BACKEND=local
MEDIA_STORAGE_PATH=instance/media

# Configure these only when using an S3-compatible object-storage service.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=

# boto3 reads AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN,
# or the configured machine/role credential provider chain.
